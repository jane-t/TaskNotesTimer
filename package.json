{
  "name": "tasknotes-timer",
  "version": "1.0.0",
  "description": "A floating timer widget for TaskNotes",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.tasknotes.timer",
    "productName": "TaskNotes Timer",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "TaskNotes Timer"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  }
}
